        <!-- ── Window chrome icon buttons ── -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#444650"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <TextBlock x:Name="lbl" Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#282b31" Duration="0:0:0.12"/>
                                        <ColorAnimation Storyboard.TargetName="lbl"
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                            To="#d8dae0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.10" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.10" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="Transparent" Duration="0:0:0.16"/>
                                        <ColorAnimation Storyboard.TargetName="lbl"
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                            To="#444650" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.10" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.10" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close button ── -->
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <TextBlock x:Name="lbl" Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       RenderTransformOrigin="0.5,0.5"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="RotateTf" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#8b1c1c" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="lbl"
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                            To="#ffffff" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="RotateTf"
                                            Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.14" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="Transparent" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="lbl"
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                            To="#444650" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="RotateTf"
                                            Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.07"/>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#b82828" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.14" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tiny ✕ inside script list items ── -->
        <Style x:Key="TinyBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#383a42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Width"           Value="16"/>
            <Setter Property="Height"          Value="16"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <TextBlock x:Name="lbl" Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       RenderTransformOrigin="0.5,0.5"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="RotateTf" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#2a1515" Duration="0:0:0.12"/>
                                        <ColorAnimation Storyboard.TargetName="lbl"
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                            To="#cc4444" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="RotateTf"
                                            Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.2" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="Transparent" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="lbl"
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                            To="#383a42" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="RotateTf"
                                            Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="0.85" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.2" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Script list item ── -->
        <Style x:Key="ScriptItem" TargetType="ListBoxItem">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#7c7e88"/>
            <Setter Property="FontFamily"                 Value="Consolas"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,7"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Margin="4,2"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SlideTf" X="0" Y="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#202228" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="SlideTf"
                                            Storyboard.TargetProperty="X" To="4" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="Transparent" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="SlideTf"
                                            Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#181a20" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="SlideTf"
                                            Storyboard.TargetProperty="X" To="2" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SlideTf"
                                            Storyboard.TargetProperty="X" To="4" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#162018"/>
                                <Setter Property="Foreground" Value="#5cdb7f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Splitter ── -->
        <Style x:Key="Splitter" TargetType="GridSplitter">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ShowsPreview"    Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2a2b30"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="#3a3c44"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Scrollbar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="6"/>
            <Setter Property="Height"     Value="6"/>
        </Style>
        <Style TargetType="Thumb">
            <Setter Property="Background"  Value="#2e3038"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4a4d58"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ROOT -->
    <Grid>
        <Border Background="#111214"
                BorderBrush="#28292e"
                BorderThickness="1"
                CornerRadius="12"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.85"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="58"/>
                </Grid.RowDefinitions>

                <!-- ══ ROW 0 — TITLE BAR ══ -->
                <Border Grid.Row="0"
                        Background="#0d0e10"
                        CornerRadius="12,12,0,0"
                        BorderBrush="#1e2026"
                        BorderThickness="0,0,0,1"
                        MouseDown="TitleBar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: logo + title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="16,0">
                            <Ellipse Width="7" Height="7" Margin="0,0,9,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#a0ffcc" Offset="0"/>
                                        <GradientStop Color="#5cdb7f" Offset="0.6"/>
                                        <GradientStop Color="#2a7a48" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#5cdb7f" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="JadeX"
                                       FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                       Foreground="#eaeef5" VerticalAlignment="Center"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock Text=" executor"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#2e3038" VerticalAlignment="Center"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"/>
                        </StackPanel>

                        <!-- CENTER: pill nav -->
                        <Border Grid.Column="1"
                                Background="#16181c"
                                BorderBrush="#242629"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="4,3"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#242529" CornerRadius="12" Padding="14,7" Margin="0,0,2,0">
                                    <TextBlock Text="Editor"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="#e8eaf0"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"/>
                                </Border>
                                <Button Style="{StaticResource PillBtn}" Content="Instances"
                                        Padding="14,4" Margin="2,0"
                                        Click="OpenMultiInstance_Click"/>
                                <Button Style="{StaticResource PillBtn}" Content="Settings"
                                        Padding="14,4" Margin="2,0"
                                        Click="OpenSettings_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT: minimize + close -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button Style="{StaticResource WinBtn}" Content="—"
                                    Click="MinimizeBtn_Click"/>
                            <Button Style="{StaticResource CloseBtn}" Content="✕"
                                    Click="CloseBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ ROW 1 — MAIN CONTENT ══ -->
                <Grid Grid.Row="1" Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ScriptsColumn" Width="168" MinWidth="0" MaxWidth="340"/>
                        <ColumnDefinition x:Name="ScriptsGapColumn" Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ─── SCRIPTS CARD ─── -->
                    <Border Grid.Column="0"
                            x:Name="ScriptsPanelBorder"
                            Background="#16181c"
                            BorderBrush="#24262d"
                            BorderThickness="1"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}"
                            ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="#12141a"
                                    BorderBrush="#1e2026"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="10,10,0,0"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SCRIPTS"
                                               FontFamily="Consolas" FontSize="9"
                                               Foreground="#363840"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"/>
                                    <Button Grid.Column="1" Style="{StaticResource WinBtn}"
                                            Content="↻" Width="20" Height="20" FontSize="13"
                                            ToolTip="Refresh" Click="RefreshScripts_Click"
                                            Margin="0,0,2,0"/>
                                    <Button Grid.Column="2" x:Name="ScriptsMenuBtn"
                                            Style="{StaticResource WinBtn}"
                                            Content="…" Width="20" Height="20" FontSize="13"
                                            ToolTip="Options" Click="ScriptsMenu_Click"/>
                                </Grid>
                            </Border>

                            <Border DockPanel.Dock="Top"
                                    Background="#12141a"
                                    BorderBrush="#1e2026"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,6">
                                <Border Background="#0e1014"
                                        BorderBrush="#22242c"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⌕"
                                                   FontSize="12" Foreground="#2e3038"
                                                   VerticalAlignment="Center"
                                                   Margin="7,0,4,0"
                                                   TextOptions.TextFormattingMode="Display"/>
                                        <TextBox x:Name="ScriptSearchBox"
                                                 Grid.Column="1"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#6e7080"
                                                 CaretBrush="#5cdb7f"
                                                 FontFamily="Consolas" FontSize="10.5"
                                                 VerticalAlignment="Center"
                                                 Padding="0,5,6,5"
                                                 TextChanged="ScriptSearch_TextChanged">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <Grid>
                                                                    <TextBlock x:Name="placeholder"
                                                                               Text="search scripts..."
                                                                               FontFamily="Consolas" FontSize="10.5"
                                                                               Foreground="#2c2e38"
                                                                               VerticalAlignment="Center"
                                                                               Padding="0,5,0,5"
                                                                               IsHitTestVisible="False"/>
                                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                                  VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </Border>
                            </Border>

                            <ListBox x:Name="ScriptsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="ScriptsList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ScriptItem}"/>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- ─── SPLITTER ─── -->
                    <GridSplitter x:Name="ScriptsSplitter"
                                  Grid.Column="1"
                                  Style="{StaticResource Splitter}"
                                  Width="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"
                                  Cursor="SizeWE"/>

                    <!-- ─── EDITOR + CONSOLE COLUMN ─── -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="100"/>
                            <RowDefinition x:Name="ConsoleSplitterRow" Height="8"/>
                            <RowDefinition x:Name="ConsoleRow" Height="140" MinHeight="0" MaxHeight="400"/>
                        </Grid.RowDefinitions>

                        <!-- EDITOR CARD -->
                        <Border Grid.Row="0"
                                Background="#16181c"
                                BorderBrush="#24262d"
                                BorderThickness="1"
                                CornerRadius="10"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ── IMPROVED TAB BAR ── -->
                                <Border Grid.Row="0"
                                        Background="#0e1014"
                                        BorderBrush="#1a1c22"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0">
                                    <DockPanel>
                                        <!-- + new tab button -->
                                        <Button DockPanel.Dock="Right"
                                                x:Name="AddTabBtn"
                                                Width="30" Height="30"
                                                Cursor="Hand"
                                                Click="AddTab_Click"
                                                ToolTip="New tab"
                                                Margin="2,2,6,2"
                                                Focusable="False">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="Transparent"
                                                            CornerRadius="7"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <TransformGroup>
                                                                <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1"/>
                                                                <RotateTransform x:Name="RotateTf" Angle="0"/>
                                                            </TransformGroup>
                                                        </Border.RenderTransform>
                                                        <TextBlock x:Name="lbl" Text="+"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Consolas" FontSize="17"
                                                                   FontWeight="Light"
                                                                   Foreground="#2e3038"
                                                                   TextOptions.TextFormattingMode="Display"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="bd"
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#1a2e1e" Duration="0:0:0.13"/>
                                                                    <ColorAnimation Storyboard.TargetName="lbl"
                                                                        Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                        To="#5cdb7f" Duration="0:0:0.13"/>
                                                                    <DoubleAnimation Storyboard.TargetName="RotateTf"
                                                                        Storyboard.TargetProperty="Angle"
                                                                        To="90" Duration="0:0:0.22">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                                                        Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.13"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                                                        Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.13"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="bd"
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="Transparent" Duration="0:0:0.16"/>
                                                                    <ColorAnimation Storyboard.TargetName="lbl"
                                                                        Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                        To="#2e3038" Duration="0:0:0.16"/>
                                                                    <DoubleAnimation Storyboard.TargetName="RotateTf"
                                                                        Storyboard.TargetProperty="Angle"
                                                                        To="0" Duration="0:0:0.20">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                                                        Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.16"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                                                        Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.16"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                                                        Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.07"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                                                        Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.07"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                                                        Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.10"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                                                        Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.10"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Scrollable tab strip -->
                                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Padding="4,0,0,0">
                                            <StackPanel x:Name="TabsPanel"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Stretch"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- Monaco Editor -->
                                <wv2:WebView2 x:Name="MonacoEditor" Grid.Row="1"
                                              NavigationCompleted="MonacoEditor_NavigationCompleted"/>
                            </Grid>
                        </Border>

                        <!-- Vertical splitter -->
                        <GridSplitter x:Name="ConsoleSplitter"
                                      Grid.Row="1"
                                      Style="{StaticResource Splitter}"
                                      Height="4"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      ResizeBehavior="PreviousAndNext"
                                      Cursor="SizeNS"/>

                        <!-- CONSOLE CARD -->
                        <Border Grid.Row="2"
                                x:Name="ConsolePanelBorder"
                                Background="#13151a"
                                BorderBrush="#1e2026"
                                BorderThickness="1"
                                CornerRadius="10"
                                Effect="{StaticResource CardShadow}"
                                ClipToBounds="True">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Background="#10121a"
                                        BorderBrush="#1a1c24"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0"
                                        Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CONSOLE"
                                                   FontFamily="Consolas" FontSize="9"
                                                   Foreground="#30323c"
                                                   VerticalAlignment="Center"
                                                   TextOptions.TextFormattingMode="Display"
                                                   TextOptions.TextRenderingMode="ClearType"/>
                                        <Button Grid.Column="1" Style="{StaticResource WinBtn}"
                                                Content="⌫" Width="20" Height="20" FontSize="11"
                                                ToolTip="Clear console"
                                                Click="ClearConsole_Click"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer x:Name="ConsoleScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Background="Transparent">
                                    <TextBlock x:Name="ConsoleOutput"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="#6e7080"
                                               TextWrapping="Wrap"
                                               Padding="12,6"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ══ MULTI INSTANCE OVERLAY ══ -->
                    <Grid Grid.Column="0" Grid.ColumnSpan="3"
                          x:Name="MultiInstanceOverlay"
                          Visibility="Collapsed"
                          Panel.ZIndex="99">

                        <Border Background="#CC0d0e10" CornerRadius="10"/>

                        <Border Background="#16181c"
                                BorderBrush="#2a2c34"
                                BorderThickness="1"
                                CornerRadius="12"
                                Width="520"
                                MaxHeight="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="44" ShadowDepth="14" Opacity="0.7" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="#10121a"
                                        BorderBrush="#1e2026"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="12,12,0,0"
                                        Padding="14,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,9,0">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#6d9ddb"/>
                                                </Ellipse.Fill>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#6d9ddb" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock Text="MULTI INSTANCE"
                                                       FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#c0c4d0"
                                                       VerticalAlignment="Center"
                                                       TextOptions.TextFormattingMode="Display"/>
                                            <TextBlock x:Name="InstanceCountLabel"
                                                       Text="  —  0 instances"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="#363840"
                                                       VerticalAlignment="Center"
                                                       TextOptions.TextFormattingMode="Display"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource WinBtn}"
                                                    Content="↻" Width="22" Height="22" FontSize="13"
                                                    ToolTip="Refresh instances"
                                                    Click="RefreshInstances_Click"
                                                    Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource CloseBtn}"
                                                    Content="✕" Width="22" Height="22"
                                                    Click="CloseMultiInstance_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Background="Transparent">
                                    <StackPanel x:Name="InstancesPanel" Margin="12,10,12,10"/>
                                </ScrollViewer>

                                <Border Grid.Row="2"
                                        Background="#10121a"
                                        BorderBrush="#1e2026"
                                        BorderThickness="0,1,0,0"
                                        CornerRadius="0,0,12,12"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,8,0">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush x:Name="SelectedDotBrush" Color="#2a2c34"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock x:Name="SelectedInstanceLabel"
                                                       Text="No instance selected"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="#363840"
                                                       VerticalAlignment="Center"
                                                       TextOptions.TextFormattingMode="Display"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                x:Name="ExecuteOnSelectedBtn"
                                                Style="{StaticResource BtnGreen}"
                                                Content="Execute on Selected"
                                                Width="152" Height="32"
                                                IsEnabled="False"
                                                Click="ExecuteOnSelected_Click"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>

                <!-- ══ ROW 2 — BOTTOM ACTION BAR ══ -->
                <Border Grid.Row="2"
                        Background="#0d0e10"
                        BorderBrush="#1a1c22"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource BtnBlue}"
                                Content="Inject"
                                Width="96" Height="34"
                                Click="InjectBtn_Click"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="14,0,0,0">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="StatusDotBrush" Color="#a63030"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="StatusGlow"
                                                      Color="#cc3333"
                                                      BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText"
                                           Text="Not Injected"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="#464850"
                                           TextOptions.TextFormattingMode="Display"
                                           TextOptions.TextRenderingMode="ClearType"/>
                                <TextBlock x:Name="StatusDetail"
                                           Text="Idle"
                                           FontFamily="Consolas" FontSize="9"
                                           Foreground="#2c2e38"
                                           Margin="0,2,0,0"
                                           TextOptions.TextFormattingMode="Display"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ToggleScriptsBtn"
                                    Style="{StaticResource PillBtn}"
                                    Content="⬛ Scripts"
                                    Padding="12,0" Height="26"
                                    Margin="0,0,6,0"
                                    Click="ToggleScripts_Click"
                                    ToolTip="Toggle Scripts panel"/>
                            <Button x:Name="ToggleConsoleBtn"
                                    Style="{StaticResource PillBtn}"
                                    Content="⬛ Console"
                                    Padding="12,0" Height="26"
                                    Margin="0,0,12,0"
                                    Click="ToggleConsole_Click"
                                    ToolTip="Toggle Console panel"/>
                            <Button Style="{StaticResource BtnGreen}"
                                    Content="Execute"
                                    Width="96" Height="34"
                                    Margin="0,0,6,0"
                                    Click="ExecuteBtn_Click"/>
                            <Button Style="{StaticResource Btn}"
                                    Content="Clear"
                                    Width="72" Height="34"
                                    Margin="0,0,6,0"
                                    Click="ClearBtn_Click"/>
                            <Button Style="{StaticResource Btn}"
                                    Content="Open"
                                    Width="72" Height="34"
                                    Margin="0,0,6,0"
                                    Click="OpenBtn_Click"/>
                            <Button Style="{StaticResource Btn}"
                                    Content="Save"
                                    Width="72" Height="34"
                                    Click="SaveBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
