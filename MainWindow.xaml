<Window x:Class="JadeX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JadeX" Height="571" Width="845"
        MinHeight="520" MinWidth="780"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <!-- ── Colours ── -->
        <SolidColorBrush x:Key="Br_Bg"       Color="#111214"/>
        <SolidColorBrush x:Key="Br_Card"     Color="#18191d"/>
        <SolidColorBrush x:Key="Br_CardEdge" Color="#2a2b30"/>
        <SolidColorBrush x:Key="Br_Green"    Color="#5cdb7f"/>
        <SolidColorBrush x:Key="Br_Blue"     Color="#6d9ddb"/>
        <SolidColorBrush x:Key="Br_Dim"      Color="#3a3b42"/>

        <!-- ── Drop-Shadow for cards ── -->
        <DropShadowEffect x:Key="CardShadow"
                          Color="#000000" BlurRadius="28"
                          ShadowDepth="6" Opacity="0.55" Direction="270"/>
        <DropShadowEffect x:Key="CardShadowHover"
                          Color="#000000" BlurRadius="40"
                          ShadowDepth="10" Opacity="0.70" Direction="270"/>
        <DropShadowEffect x:Key="GreenGlow"
                          Color="#5cdb7f" BlurRadius="14"
                          ShadowDepth="0" Opacity="0.55"/>
        <DropShadowEffect x:Key="BlueGlow"
                          Color="#6d9ddb" BlurRadius="14"
                          ShadowDepth="0" Opacity="0.55"/>

        <!-- ════════════════════════════════════════
             PILL NAV BUTTON
             ════════════════════════════════════════ -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#50525a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <TextBlock x:Name="lbl"
                                       Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#242529" Duration="0:0:0.14"/>
                                        <ColorAnimation Storyboard.TargetName="lbl"
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                            To="#9ea0aa" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="Transparent" Duration="0:0:0.18"/>
                                        <ColorAnimation Storyboard.TargetName="lbl"
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                            To="#50525a" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="0.93" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="0.93" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Pill -->
        <Style x:Key="PillBtnActive" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Background" Value="#242529"/>
            <Setter Property="Foreground" Value="#e8e9ef"/>
        </Style>

        <!-- Toggle Pill -->
        <Style x:Key="PillBtnToggle" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <!-- ════════════════════════════════════════
             STANDARD ACTION BUTTON
             ════════════════════════════════════════ -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background"      Value="#1e2024"/>
            <Setter Property="Foreground"      Value="#c0c2cc"/>
            <Setter Property="BorderBrush"     Value="#2e3038"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#282b31" Duration="0:0:0.14"/>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                            To="#484c58" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#1e2024" Duration="0:0:0.17"/>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                            To="#2e3038" Duration="0:0:0.17"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.17"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.17"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.07"/>
                                        <ColorAnimation Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#141618" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTf"
                                            Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

